else if (replace (current_color, grey_color_3, grey_replace_3, final_color, tolerance)){}
else if (replace (current_color, grey_color_4, grey_replace_4, final_color, tolerance)){}

else if (replace (current_color, skin_color_1, skin_replace_1, final_color, tolerance)){}
else if (replace (current_color, skin_color_2, skin_replace_2, final_color, tolerance)){}
else if (replace (current_color, skin_color_3, skin_replace_3, final_color, tolerance)){}

else if (replace (current_color, aura_color, aura_color_replace, final_color, tolerance)){}
else if (replace (current_color, awakened_effect1, awakened_effect_replace1, final_color, tolerance)){}
