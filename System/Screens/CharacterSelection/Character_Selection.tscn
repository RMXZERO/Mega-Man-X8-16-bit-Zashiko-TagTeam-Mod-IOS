[connection signal="focus_exited" from="Menu/next_player" to="Menu/next_player" method="_on_focus_exited"]
[connection signal="mouse_entered" from="Menu/next_player" to="Menu/next_player" method="_on_mouse_entered"]
[connection signal="mouse_exited" from="Menu/next_player" to="Menu/next_player" method="_on_mouse_exited"]
[connection signal="pressed" from="Menu/next_player" to="Menu/next_player" method="_on_pressed"]
[connection signal="focus_entered" from="Menu/prev_player" to="Menu/prev_player" method="_on_focus_entered"]
[connection signal="focus_exited" from="Menu/prev_player" to="Menu/prev_player" method="_on_focus_exited"]
[connection signal="mouse_entered" from="Menu/prev_player" to="Menu/prev_player" method="_on_mouse_entered"]
[connection signal="mouse_exited" from="Menu/prev_player" to="Menu/prev_player" method="_on_mouse_exited"]
[connection signal="pressed" from="Menu/prev_player" to="Menu/prev_player" method="_on_pressed"]
[connection signal="pressed" from="AndroidControls/left" to="Menu/characters/panel/char_container" method="switch_characters" binds= [ "left" ]]
[connection signal="pressed" from="AndroidControls/right" to="Menu/characters/panel/char_container" method="switch_characters" binds= [ "right" ]]
[connection signal="pressed" from="AndroidControls/up" to="Menu/characters/panel/char_container" method="switch_armor" binds= [ -1 ]]
[connection signal="pressed" from="AndroidControls/down" to="Menu/characters/panel/char_container" method="switch_armor" binds= [ 1 ]]
