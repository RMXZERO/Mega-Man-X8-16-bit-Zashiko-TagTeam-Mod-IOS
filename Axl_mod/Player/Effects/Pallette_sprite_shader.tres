else if (replace (current_color, flame_color_3, replace_flame_color_3, final_color, tolerance)){}

else if (replace (current_color, gley_color_1, gley_replace_1, final_color, tolerance)){}
else if (replace (current_color, gley_color_2, gley_replace_2, final_color, tolerance)){}
else if (replace (current_color, gley_color_3, gley_replace_3, final_color, tolerance)){}

else if (replace (current_color, outline_color, replace_outline_color, final_color, tolerance)){}

else if (replace (current_color, skin_color_1, skin_color_replace1, final_color, tolerance)){}
else if (replace (current_color, skin_color_2, skin_color_replace2, final_color, tolerance)){}
else if (replace (current_color, skin_color_3, skin_color_replace3, final_color, tolerance)){}

else if (replace (current_color, afterimages_color1, afterimages_color_replace1, final_color, tolerance)){}
else if (replace (current_color, afterimages_color2, afterimages_color_replace2, final_color, tolerance)){}

else if (replace (current_color, saber_color_1, saber_color_replace1, final_color, tolerance)){}
else if (replace (current_color, saber_color_2, saber_color_replace2, final_color, tolerance)){}
else if (replace (current_color, saber_color_3, saber_color_replace3, final_color, tolerance)){}
else if (replace (current_color, saber_color_4, saber_color_replace4, final_color, tolerance)){}
else if (replace (current_color, saber_color_5, saber_color_replace5, final_color, tolerance)){}

else {final_color = current_color}"
