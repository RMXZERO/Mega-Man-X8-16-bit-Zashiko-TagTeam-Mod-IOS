else if (replace (current_color, yellow_color_1, replace_yellow_color_1, final_color, tolerance)){}
else if (replace (current_color, yellow_color_2, replace_yellow_color_2, final_color, tolerance)){}

else if (replace (current_color, red_color_1, replace_red_color_1, final_color, tolerance)){}
else if (replace (current_color, red_color_2, replace_red_color_2, final_color, tolerance)){}

else if (replace (current_color, flame_color_1, replace_flame_color_1, final_color, tolerance)){}
