else if (replace (current_color, flame_color_3, replace_flame_color_3, final_color, tolerance)){}

else if (replace (current_color, gley_color_1, gley_replace_1, final_color, tolerance)){}
else if (replace (current_color, gley_color_2, gley_replace_2, final_color, tolerance)){}
else if (replace (current_color, gley_color_3, gley_replace_3, final_color, tolerance)){}

else if (replace (current_color, outline_color, replace_outline_color, final_color, tolerance)){}

else if (replace (current_color, skin_color_1, skin_color_replace1, final_color, tolerance)){}
